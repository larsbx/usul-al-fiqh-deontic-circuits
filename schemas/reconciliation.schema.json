{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/schemas/reconciliation.schema.json",
  "title": "Reconciliation ledger: the bank's disputed furūʿ, weighed by proof (Usul.Tarjih) with the holders' attribution kept as a record (Usul.Reconcile) (candidates)",
  "type": "object",
  "required": [
    "suite",
    "status",
    "provenance",
    "entries"
  ],
  "additionalProperties": false,
  "$defs": {
    "grade": {
      "enum": [
        "tashih",
        "nass",
        "zahir",
        "qiyas",
        "jazm",
        "ashab",
        "takhrij",
        "wajh"
      ]
    },
    "tier": {
      "enum": [
        "istishab",
        "qiyas",
        "mursalDaif",
        "aqrabSahabi",
        "fatwaSahabi",
        "zanni",
        "qati",
        "ijma"
      ]
    },
    "murajjih": {
      "enum": [
        "kathratRuwat",
        "tayaqquz",
        "wara",
        "sahibWaqia",
        "mubashir",
        "corroborated",
        "marfu",
        "consistentNarrator",
        "muttasil",
        "naqil",
        "muthbit",
        "usulMany",
        "tardAks",
        "mutaaddiya",
        "wasf",
        "ithbat",
        "aslShari",
        "aslAgreed",
        "aslStronger",
        "muaththira",
        "mulaima",
        "munasaba",
        "sahihayn",
        "masmu",
        "qawl",
        "fil",
        "nahy",
        "amr",
        "khass",
        "ammMahfuz",
        "iqtida",
        "ima",
        "muwafaqa",
        "muallal",
        "hazir",
        "mantuq",
        "nass",
        "mubayyan",
        "haqiqa",
        "ashhar",
        "siyaq",
        "afqah",
        "khiffa",
        "hissiyya",
        "fewerAwsaf",
        "dariHadd"
      ]
    }
  },
  "properties": {
    "suite": {
      "const": "reconciliation"
    },
    "status": {
      "const": "candidate"
    },
    "provenance": {
      "type": "string",
      "minLength": 1
    },
    "entries": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "far",
          "grades",
          "jam",
          "naskh",
          "positions_sha256"
        ],
        "additionalProperties": false,
        "properties": {
          "far": {
            "type": "string"
          },
          "grades": {
            "type": "array",
            "minItems": 2,
            "items": {
              "oneOf": [
                {
                  "$ref": "#/$defs/grade"
                },
                {
                  "type": "array",
                  "minItems": 2,
                  "uniqueItems": true,
                  "items": {
                    "$ref": "#/$defs/grade"
                  }
                }
              ]
            }
          },
          "jam": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "type": "object",
                "required": [
                  "encoder",
                  "from",
                  "farq"
                ],
                "additionalProperties": false,
                "properties": {
                  "encoder": {
                    "type": "string"
                  },
                  "from": {
                    "type": "string"
                  },
                  "farq": {
                    "type": "string"
                  }
                }
              }
            ]
          },
          "register": {
            "type": "string",
            "pattern": "^RQ-[0-9]{2}$",
            "description": "An open research question that leaves an on-madhhab case standing although its tarjīḥ goes the other way."
          },
          "naskh": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "type": "object",
                "required": [
                  "ruling",
                  "ref",
                  "note"
                ],
                "additionalProperties": false,
                "properties": {
                  "ruling": {
                    "type": [
                      "boolean",
                      "string",
                      "integer"
                    ],
                    "description": "One of the case's reported rulings (enforced by reconcile.check)."
                  },
                  "ref": {
                    "type": "string",
                    "pattern": "^src:[^/]+/v\\d+:p\\d+$",
                    "description": "The page of an evidence item in this entry attesting the ruling with its chronology."
                  },
                  "note": {
                    "type": "string",
                    "minLength": 1
                  }
                }
              }
            ]
          },
          "note": {
            "type": "string",
            "minLength": 1
          },
          "evidence": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "ref",
                "excerpt_ar",
                "position",
                "grade",
                "who",
                "note"
              ],
              "additionalProperties": false,
              "properties": {
                "ref": {
                  "type": "string",
                  "pattern": "^src:[^/]+/v\\d+:p\\d+$"
                },
                "excerpt_ar": {
                  "type": "string",
                  "minLength": 20
                },
                "position": {
                  "type": "integer",
                  "minimum": 0
                },
                "grade": {
                  "$ref": "#/$defs/grade"
                },
                "who": {
                  "type": "string",
                  "minLength": 1
                },
                "note": {
                  "type": "string",
                  "minLength": 1
                }
              }
            },
            "uniqueItems": true,
            "description": "Each cited page grades a position once (enforced by reconcile.check on (ref, position)); exact copies are rejected here."
          },
          "proofs": {
            "description": "The proofs each position cites, by tier (Rawḍa v02 p389–390). Present = weighed; a position may cite none.",
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "position",
                "tier",
                "dalil",
                "ref",
                "excerpt_ar",
                "note"
              ],
              "additionalProperties": false,
              "properties": {
                "position": {
                  "type": "integer",
                  "minimum": 0
                },
                "tier": {
                  "$ref": "#/$defs/tier"
                },
                "dalil": {
                  "type": "string",
                  "minLength": 1,
                  "description": "the proof itself: the āya, the report with its grade, the ijmāʿ, the aṣl and ʿilla"
                },
                "ref": {
                  "type": "string",
                  "pattern": "^src:[^/]+/v\\d+:p\\d+$"
                },
                "excerpt_ar": {
                  "type": "string",
                  "minLength": 1
                },
                "who": {
                  "type": "string"
                },
                "note": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          },
          "advantages": {
            "description": "Murajjiḥāt between two positions' proofs of one tier: stated by a source comparing them, or applied by the bank to properties the proofs show (Usul.Tarjih.Basis).",
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "basis",
                "by",
                "excerpt_ar",
                "for",
                "note",
                "over",
                "ref"
              ],
              "additionalProperties": false,
              "properties": {
                "for": {
                  "type": "integer",
                  "minimum": 0
                },
                "over": {
                  "type": "integer",
                  "minimum": 0
                },
                "by": {
                  "$ref": "#/$defs/murajjih"
                },
                "ref": {
                  "type": "string",
                  "pattern": "^src:[^/]+/v\\d+:p\\d+$"
                },
                "excerpt_ar": {
                  "type": "string",
                  "minLength": 1
                },
                "who": {
                  "type": "string"
                },
                "note": {
                  "type": "string",
                  "minLength": 1
                },
                "basis": {
                  "enum": [
                    "stated",
                    "applied"
                  ]
                }
              }
            }
          },
          "searched": {
            "type": "string",
            "minLength": 1,
            "description": "Where the weigher looked for the positions' proofs; required when none was found."
          },
          "positions_sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$",
            "description": "SHA-256 of usul.positions.v1 canonical JSON: case identity and ordered complete position records. Checked before overlay and resolution."
          }
        }
      }
    }
  }
}

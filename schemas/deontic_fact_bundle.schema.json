{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/schemas/deontic_fact_bundle.schema.json",
  "title": "Deontic Fact Bundle",
  "type": "object",
  "required": ["bundle_id", "version", "records"],
  "additionalProperties": false,
  "properties": {
    "bundle_id": {"type": "string", "minLength": 1},
    "version": {"type": "string", "minLength": 1},
    "source": {"type": "string"},
    "records": {
      "type": "array",
      "items": {"$ref": "#/$defs/record"}
    }
  },
  "$defs": {
    "record": {
      "oneOf": [
        {"$ref": "#/$defs/affect_root"},
        {"$ref": "#/$defs/warrant"},
        {"$ref": "#/$defs/refinement_edge"},
        {"$ref": "#/$defs/opposition_edge"},
        {"$ref": "#/$defs/hukm_classification"},
        {"$ref": "#/$defs/defeater"}
      ]
    },
    "canonical_id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*$"
    },
    "non_empty_string": {
      "type": "string",
      "minLength": 1
    },
    "target": {
      "type": "object",
      "required": ["kind", "id"],
      "additionalProperties": false,
      "properties": {
        "kind": {"enum": ["root", "compound", "profile", "object_cluster", "external_concept"]},
        "id": {"$ref": "#/$defs/canonical_id"}
      }
    },
    "affect_root": {
      "type": "object",
      "required": ["kind", "id", "display", "cluster"],
      "additionalProperties": false,
      "properties": {
        "kind": {"const": "affect_root"},
        "id": {"$ref": "#/$defs/canonical_id"},
        "display": {"$ref": "#/$defs/non_empty_string"},
        "arabic_root": {"type": "string"},
        "gloss": {"type": "string"},
        "cluster": {"$ref": "#/$defs/non_empty_string"},
        "aliases": {"type": "array", "items": {"type": "string"}},
        "verse_refs": {"type": "array", "items": {"type": "string"}}
      }
    },
    "warrant": {
      "oneOf": [
        {"$ref": "#/$defs/quranic_warrant"},
        {"$ref": "#/$defs/lexical_warrant"},
        {"$ref": "#/$defs/behavioral_warrant"},
        {"$ref": "#/$defs/somatic_warrant"},
        {"$ref": "#/$defs/tafsir_warrant"},
        {"$ref": "#/$defs/inferred_warrant"},
        {"$ref": "#/$defs/commentary_warrant"}
      ]
    },
    "quranic_warrant": {
      "type": "object",
      "required": ["kind", "id", "tier", "source_kind", "status", "locator", "reference"],
      "additionalProperties": false,
      "properties": {
        "kind": {"const": "warrant"},
        "id": {"$ref": "#/$defs/canonical_id"},
        "tier": {"enum": [1, 2, 3, 4]},
        "source_kind": {"const": "quranic"},
        "status": {"enum": ["candidate", "accepted", "quarantined", "rejected"]},
        "locator": {"$ref": "#/$defs/non_empty_string"},
        "reference": {"$ref": "#/$defs/non_empty_string"},
        "note": {"type": "string"},
        "quarantine_reason": {"type": "string"}
      }
    },
    "lexical_warrant": {
      "type": "object",
      "required": ["kind", "id", "tier", "source_kind", "status", "locator", "source", "lemma"],
      "additionalProperties": false,
      "properties": {
        "kind": {"const": "warrant"},
        "id": {"$ref": "#/$defs/canonical_id"},
        "tier": {"enum": [1, 2, 3, 4]},
        "source_kind": {"const": "lexical"},
        "status": {"enum": ["candidate", "accepted", "quarantined", "rejected"]},
        "locator": {"$ref": "#/$defs/non_empty_string"},
        "source": {"$ref": "#/$defs/non_empty_string"},
        "lemma": {"$ref": "#/$defs/non_empty_string"},
        "note": {"type": "string"},
        "quarantine_reason": {"type": "string"}
      }
    },
    "behavioral_warrant": {
      "type": "object",
      "required": ["kind", "id", "tier", "source_kind", "status", "locator", "verse_range", "target", "signatures"],
      "additionalProperties": false,
      "properties": {
        "kind": {"const": "warrant"},
        "id": {"$ref": "#/$defs/canonical_id"},
        "tier": {"enum": [1, 2, 3, 4]},
        "source_kind": {"const": "behavioral"},
        "status": {"enum": ["candidate", "accepted", "quarantined", "rejected"]},
        "locator": {"$ref": "#/$defs/non_empty_string"},
        "verse_range": {"$ref": "#/$defs/non_empty_string"},
        "target": {"$ref": "#/$defs/target"},
        "signatures": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/canonical_id"}
        },
        "note": {"type": "string"},
        "quarantine_reason": {"type": "string"}
      }
    },
    "somatic_warrant": {
      "type": "object",
      "required": ["kind", "id", "tier", "source_kind", "status", "locator", "body_part", "state", "verses"],
      "additionalProperties": false,
      "properties": {
        "kind": {"const": "warrant"},
        "id": {"$ref": "#/$defs/canonical_id"},
        "tier": {"enum": [1, 2, 3, 4]},
        "source_kind": {"const": "somatic"},
        "status": {"enum": ["candidate", "accepted", "quarantined", "rejected"]},
        "locator": {"$ref": "#/$defs/non_empty_string"},
        "body_part": {"$ref": "#/$defs/non_empty_string"},
        "state": {"$ref": "#/$defs/non_empty_string"},
        "verses": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string", "minLength": 1}
        },
        "note": {"type": "string"},
        "quarantine_reason": {"type": "string"}
      }
    },
    "tafsir_warrant": {
      "type": "object",
      "required": ["kind", "id", "tier", "source_kind", "status", "locator", "source", "reference"],
      "additionalProperties": false,
      "properties": {
        "kind": {"const": "warrant"},
        "id": {"$ref": "#/$defs/canonical_id"},
        "tier": {"enum": [1, 2, 3, 4]},
        "source_kind": {"const": "tafsir"},
        "status": {"enum": ["candidate", "accepted", "quarantined", "rejected"]},
        "locator": {"$ref": "#/$defs/non_empty_string"},
        "source": {"$ref": "#/$defs/non_empty_string"},
        "reference": {"$ref": "#/$defs/non_empty_string"},
        "note": {"type": "string"},
        "quarantine_reason": {"type": "string"}
      }
    },
    "inferred_warrant": {
      "type": "object",
      "required": ["kind", "id", "tier", "source_kind", "status", "locator", "reason", "dependencies"],
      "additionalProperties": false,
      "properties": {
        "kind": {"const": "warrant"},
        "id": {"$ref": "#/$defs/canonical_id"},
        "tier": {"enum": [1, 2, 3, 4]},
        "source_kind": {"const": "inferred"},
        "status": {"enum": ["candidate", "accepted", "quarantined", "rejected"]},
        "locator": {"$ref": "#/$defs/non_empty_string"},
        "reason": {"$ref": "#/$defs/non_empty_string"},
        "dependencies": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/canonical_id"}
        },
        "note": {"type": "string"},
        "quarantine_reason": {"type": "string"}
      }
    },
    "commentary_warrant": {
      "type": "object",
      "required": ["kind", "id", "tier", "source_kind", "status", "locator", "author", "work"],
      "additionalProperties": false,
      "properties": {
        "kind": {"const": "warrant"},
        "id": {"$ref": "#/$defs/canonical_id"},
        "tier": {"enum": [1, 2, 3, 4]},
        "source_kind": {"const": "commentary"},
        "status": {"enum": ["candidate", "accepted", "quarantined", "rejected"]},
        "locator": {"$ref": "#/$defs/non_empty_string"},
        "author": {"$ref": "#/$defs/non_empty_string"},
        "work": {"$ref": "#/$defs/non_empty_string"},
        "note": {"type": "string"},
        "quarantine_reason": {"type": "string"}
      }
    },
    "refinement_edge": {
      "type": "object",
      "required": ["kind", "id", "child", "parent", "warrant_id"],
      "additionalProperties": false,
      "properties": {
        "kind": {"const": "refinement_edge"},
        "id": {"$ref": "#/$defs/canonical_id"},
        "child": {"$ref": "#/$defs/target"},
        "parent": {"$ref": "#/$defs/target"},
        "warrant_id": {"$ref": "#/$defs/canonical_id"}
      }
    },
    "opposition_edge": {
      "type": "object",
      "required": ["kind", "id", "left", "right", "warrant_id"],
      "additionalProperties": false,
      "properties": {
        "kind": {"const": "opposition_edge"},
        "id": {"$ref": "#/$defs/canonical_id"},
        "left": {"$ref": "#/$defs/target"},
        "right": {"$ref": "#/$defs/target"},
        "warrant_id": {"$ref": "#/$defs/canonical_id"},
        "symmetric": {"type": "boolean", "default": true}
      }
    },
    "hukm_classification": {
      "type": "object",
      "required": ["kind", "id", "target", "object", "hukm", "warrant_id"],
      "additionalProperties": false,
      "properties": {
        "kind": {"const": "hukm_classification"},
        "id": {"$ref": "#/$defs/canonical_id"},
        "target": {"$ref": "#/$defs/target"},
        "object": {"$ref": "#/$defs/non_empty_string"},
        "hukm": {"enum": ["wajib", "mandub", "mubah", "makruh", "haram", "haram_when_dominant", "haram_when_ibadah_grade"]},
        "condition": {"type": "string"},
        "warrant_id": {"$ref": "#/$defs/canonical_id"}
      }
    },
    "defeater": {
      "type": "object",
      "required": ["kind", "id", "target", "defeats", "warrant_id"],
      "additionalProperties": false,
      "properties": {
        "kind": {"const": "defeater"},
        "id": {"$ref": "#/$defs/canonical_id"},
        "target": {"$ref": "#/$defs/target"},
        "defeats": {"$ref": "#/$defs/canonical_id"},
        "condition": {"type": "string"},
        "warrant_id": {"$ref": "#/$defs/canonical_id"}
      }
    }
  }
}

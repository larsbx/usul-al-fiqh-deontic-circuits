{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/schemas/research_question.schema.json",
  "title": "Research register",
  "description": "Questions the method surfaces that are neither a reading of one of al-Saʿdī's rules (those go to the IQ register) nor decidable by the bank's own procedure. Each records the policy in force until it is researched and decided. Nothing here adopts anything.",
  "type": "object",
  "required": ["register", "status", "questions"],
  "additionalProperties": false,
  "properties": {
    "register": {"const": "research"},
    "status": {"const": "candidate"},
    "questions": {"type": "array", "items": {"$ref": "#/$defs/question"}}
  },
  "$defs": {
    "question": {
      "type": "object",
      "required": ["id", "title", "raised_by", "question", "policy_in_force", "pins", "sources", "alternatives", "research", "status"],
      "additionalProperties": false,
      "properties": {
        "id": {"type": "string", "pattern": "^RQ-[0-9]{2}$"},
        "title": {"type": "string", "minLength": 1},
        "raised_by": {"type": "string", "description": "the document or commit that surfaced it"},
        "question": {"type": "string", "minLength": 1},
        "policy_in_force": {"type": "string", "minLength": 1, "description": "what the pipeline does until a decision; set by a human"},
        "pins": {"type": "array", "minItems": 1, "items": {"type": "string", "pattern": "^Usul\\."}},
        "sources": {"type": "array", "minItems": 1, "items": {
          "type": "object", "required": ["ref", "excerpt_ar", "note"], "additionalProperties": false,
          "properties": {"ref": {"type": "string", "pattern": "^src:[a-z0-9-]+/v[0-9]+:p[0-9]+$"}, "excerpt_ar": {"type": "string", "minLength": 1, "maxLength": 400}, "note": {"type": "string", "minLength": 1}}}},
        "alternatives": {"type": "array", "minItems": 2, "items": {"type": "string"}},
        "research": {"type": "array", "minItems": 1, "items": {"type": "string"}, "description": "concrete next steps"},
        "status": {"enum": ["open-research", "ready-for-decision", "decided", "withdrawn"]},
        "collation": {"$ref": "#/$defs/collation"},
        "decision": {"type": "object", "required": ["by", "date", "adopted"], "properties": {"by": {"const": "human"}, "date": {"type": "string"}, "adopted": {"type": "string"}}}
      }
    },
    "collation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "date",
        "status",
        "base_commit",
        "result",
        "witnesses",
        "findings",
        "consequences"
      ],
      "properties": {
        "date": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        },
        "status": {
          "const": "candidate"
        },
        "base_commit": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "result": {
          "type": "string",
          "minLength": 1
        },
        "witnesses": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/collationWitness"
          }
        },
        "findings": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "consequences": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "case",
            "reading",
            "classification",
            "reconciliation",
            "provenance"
          ],
          "properties": {
            "case": {
              "type": "string",
              "minLength": 1
            },
            "reading": {
              "type": "string",
              "minLength": 1
            },
            "classification": {
              "type": "string",
              "minLength": 1
            },
            "reconciliation": {
              "type": "string",
              "minLength": 1
            },
            "provenance": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    },
    "collationWitness": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "cache_group",
        "cache_file",
        "url",
        "sha256",
        "bytes",
        "edition_claim",
        "independence_note",
        "locator",
        "excerpt_ar",
        "has_negation"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "cache_group": {
          "enum": [
            "corpus",
            "rq05"
          ]
        },
        "cache_file": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_.-]+$"
        },
        "url": {
          "type": "string",
          "pattern": "^https://raw\\.githubusercontent\\.com/[^/]+/[^/]+/[0-9a-f]{40}/"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "bytes": {
          "type": "integer",
          "minimum": 1
        },
        "edition_claim": {
          "type": "string",
          "minLength": 1
        },
        "independence_note": {
          "type": "string",
          "minLength": 1
        },
        "locator": {
          "type": "string",
          "pattern": "^v[0-9]+:p[0-9]+$"
        },
        "excerpt_ar": {
          "type": "string",
          "minLength": 1,
          "maxLength": 400
        },
        "has_negation": {
          "type": "boolean"
        }
      }
    }
  }
}

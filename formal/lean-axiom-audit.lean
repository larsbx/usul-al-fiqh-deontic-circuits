-- Appended to imports generated by check-lean-axioms.py. A non-module root loads
-- private declarations as well, including from libraries using the module system.
open Lean Elab Command

set_option maxHeartbeats 0 in
run_cmd do
  let env := (← getEnv).setExporting false
  let modules := env.allImportedModuleNames
  let owned := modules.filter fun m => auditRoots.contains m.getRoot.toString
  for m in owned do
    IO.println s!"module\t{m}"
  let declarations := env.constants.toList.toArray.qsort (fun a b => a.1.toString < b.1.toString)
  for (name, info) in declarations do
    let some index := env.getModuleIdxFor? name | continue
    let m := modules[index.toNat]!
    unless owned.contains m do continue
    let kind := match info with
      | .thmInfo _ => "theorem"
      | .axiomInfo _ => "axiom"
      | _ => "other"
    let dependencies ← collectAxioms name
    let axioms := String.intercalate "," (dependencies.toList.map toString)
    IO.println s!"{kind}\t{m}\t{name}\t{axioms}"

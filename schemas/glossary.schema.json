{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/schemas/glossary.schema.json",
  "title": "Glossary: the uṣūl terms the formalisation uses, each defined from the pinned sources and linked to its Lean constants",
  "type": "object",
  "required": [
    "status",
    "provenance",
    "terms"
  ],
  "additionalProperties": false,
  "properties": {
    "status": {
      "const": "candidate"
    },
    "provenance": {
      "type": "string",
      "minLength": 1
    },
    "terms": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "key",
          "ar",
          "tr",
          "gloss",
          "definition",
          "refs"
        ],
        "additionalProperties": false,
        "properties": {
          "key": {
            "type": "string",
            "pattern": "^[a-z0-9_]+$"
          },
          "ar": {
            "type": "string",
            "minLength": 1
          },
          "tr": {
            "type": "string",
            "minLength": 1
          },
          "gloss": {
            "type": "string",
            "minLength": 1
          },
          "definition": {
            "type": "string",
            "minLength": 1
          },
          "conditions": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "related": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[a-z0-9_]+$"
            }
          },
          "lean": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^Usul\\."
            }
          },
          "refs": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/ref"
            },
            "minItems": 1
          }
        }
      }
    }
  },
  "$defs": {
    "ref": {
      "type": "object",
      "required": [
        "ref",
        "note"
      ],
      "additionalProperties": false,
      "properties": {
        "ref": {
          "type": "string",
          "minLength": 1
        },
        "excerpt_ar": {
          "type": "string",
          "minLength": 1,
          "maxLength": 400
        },
        "note": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/schemas/review_question.schema.json",
  "title": "Interpretive-question register (surfaced for review; decides nothing)",
  "type": "object",
  "required": ["register", "status", "provenance", "authority", "questions"],
  "additionalProperties": false,
  "properties": {
    "register": {"type": "string"},
    "status": {"const": "candidate"},
    "provenance": {"type": "string", "minLength": 1},
    "authority": {
      "type": "object",
      "required": ["gate", "class", "basis", "this_register_may", "this_register_may_not"],
      "additionalProperties": false,
      "properties": {
        "gate": {"const": "SHARIAH-AUTHORITY"},
        "class": {"const": "C"},
        "basis": {"type": "array", "items": {"type": "string"}, "minItems": 1},
        "this_register_may": {"type": "array", "items": {"type": "string"}},
        "this_register_may_not": {"type": "array", "items": {"type": "string"}}
      }
    },
    "questions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "rules", "schemata", "pins", "commitment", "alternatives", "if_changed", "route", "status"],
        "additionalProperties": false,
        "properties": {
          "id": {"type": "string", "pattern": "^IQ-[0-9]{2}$"},
          "rules": {"type": "array", "items": {"type": "integer", "minimum": 1, "maximum": 60}, "minItems": 1},
          "schemata": {"type": "array", "items": {"enum": ["S1-invariance", "S2-priority", "S3-gate", "S4-closure", "S5-inert", "S6-presumption", "S7-merge", "S8-optimal"]}, "minItems": 1},
          "pins": {"type": "array", "items": {"type": "string", "pattern": "^Usul\\."}, "minItems": 1},
          "commitment": {"type": "string", "minLength": 1},
          "alternatives": {"type": "array", "items": {"type": "string"}, "minItems": 1},
          "if_changed": {"type": "string", "minLength": 1},
          "route": {"enum": [
            "halaqa:shared/usul-k/kernel-contract.md",
            "halaqa:shared/usul-k/operators.md",
            "halaqa:shared/usul-k/specificity.md",
            "halaqa:shared/usul-k/derogation.md",
            "halaqa:shared/usul-k/evidence-order.md",
            "halaqa:shared/usul-k/resolution-schema.md"
          ]},
          "status": {"enum": ["open", "answered", "withdrawn"]}
        }
      }
    }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/schemas/reconciliation.schema.json",
  "title": "Reconciliation ledger: the bank's apparent contradictions, graded and resolved by Usul.Reconcile (candidates)",
  "type": "object",
  "required": [
    "suite",
    "status",
    "provenance",
    "entries"
  ],
  "additionalProperties": false,
  "$defs": {
    "grade": {
      "enum": [
        "tashih",
        "nass",
        "zahir",
        "qiyas",
        "jazm",
        "ashab",
        "takhrij",
        "wajh"
      ]
    }
  },
  "properties": {
    "suite": {
      "const": "reconciliation"
    },
    "status": {
      "const": "candidate"
    },
    "provenance": {
      "type": "string",
      "minLength": 1
    },
    "entries": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "far",
          "grades",
          "jam",
          "naskh"
        ],
        "additionalProperties": false,
        "properties": {
          "far": {
            "type": "string"
          },
          "grades": {
            "type": "array",
            "minItems": 2,
            "items": {
              "oneOf": [
                {
                  "$ref": "#/$defs/grade"
                },
                {
                  "type": "array",
                  "minItems": 2,
                  "uniqueItems": true,
                  "items": {
                    "$ref": "#/$defs/grade"
                  }
                }
              ]
            }
          },
          "jam": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "type": "object",
                "required": [
                  "encoder",
                  "from",
                  "farq"
                ],
                "additionalProperties": false,
                "properties": {
                  "encoder": {
                    "type": "string"
                  },
                  "from": {
                    "type": "string"
                  },
                  "farq": {
                    "type": "string"
                  }
                }
              }
            ]
          },
          "register": {
            "type": "string",
            "pattern": "^RQ-[0-9]{2}$",
            "description": "An open research question that leaves an on-madhhab case standing although its tarjīḥ goes the other way."
          },
          "naskh": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "type": "object",
                "required": [
                  "ruling",
                  "ref",
                  "note"
                ],
                "additionalProperties": false,
                "properties": {
                  "ruling": {
                    "type": [
                      "boolean",
                      "string",
                      "integer"
                    ],
                    "description": "One of the case's reported rulings (enforced by reconcile.check)."
                  },
                  "ref": {
                    "type": "string",
                    "pattern": "^src:[^/]+/v\\d+:p\\d+$",
                    "description": "The page of an evidence item in this entry attesting the ruling with its chronology."
                  },
                  "note": {
                    "type": "string",
                    "minLength": 1
                  }
                }
              }
            ]
          },
          "note": {
            "type": "string",
            "minLength": 1
          },
          "evidence": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "ref",
                "excerpt_ar",
                "position",
                "grade",
                "who",
                "note"
              ],
              "additionalProperties": false,
              "properties": {
                "ref": {
                  "type": "string",
                  "pattern": "^src:[^/]+/v\\d+:p\\d+$"
                },
                "excerpt_ar": {
                  "type": "string",
                  "minLength": 20
                },
                "position": {
                  "type": "integer",
                  "minimum": 0
                },
                "grade": {
                  "$ref": "#/$defs/grade"
                },
                "who": {
                  "type": "string",
                  "minLength": 1
                },
                "note": {
                  "type": "string",
                  "minLength": 1
                }
              }
            },
            "uniqueItems": true,
            "description": "Each cited page grades a position once (enforced by reconcile.check on (ref, position)); exact copies are rejected here."
          }
        }
      }
    }
  }
}

import Lean
import Usul.Typing.Encoders

/-!
# Export the type system to Prolog

Lean is the authority for the type system (`Usul.Typing`). This script reads it from the kernel's
own declarations and writes `examples/v41_types.pl`, the executable mirror the Prolog typing rules
(`examples/v41_typing.pl`) run on:

* `qaida_type(T, Doc)`: each structure in `Usul.Typing.Qaida`, with its docstring (the qāʿida's
  statement);
* `type_extends(T, P)`: its `extends` parents;
* `type_field(T, F, LeanType)`: the fields it declares itself;
* `encoder_type(E, Out)` and `encoder_reads(E, I, F)`: each `Typed Situation Out`, with the fields
  its `proj` reads, in order (the components of its `Local`), collected from the elaborated term.

Names become snake_case atoms (`trustLoss` ↦ `trust_loss`), matching `takhrij.ENCODERS`.
Run from `formal/lean`: `lake env lean scripts/ExportTypes.lean`. CI regenerates and diffs it.
-/

open Lean Meta

def qaidaNs : Name := `Usul.Typing.Qaida

def snake (s : String) : String :=
  s.foldl (fun acc c => if c.isUpper && !acc.isEmpty then acc ++ "_" ++ c.toLower.toString else acc.push c.toLower) ""

def atom (n : Name) : String := snake n.componentsRev.head!.toString

def quoted (s : String) : String :=
  "'" ++ (s.replace "\\" "\\\\" |>.replace "'" "\\'" |>.replace "\n" " ") ++ "'"

/-- `f` is the projection to a parent structure (`toYaqin`), not a fact. -/
def isParent (env : Environment) (s f : Name) : Bool := (isSubobjectField? env s f).isSome

partial def reads (env : Environment) (e : Expr) : StateM (Array Name) Unit := do
  match e with
  | .const c _ =>
    if (env.getProjectionFnInfo? c).isSome then
      let f := c.componentsRev.head!
      if !isParent env c.getPrefix f && (qaidaNs.isPrefixOf c || (`Usul.Typing.Situation).isPrefixOf c) then
        unless (← get).contains f do modify (·.push f)
  | .app f a => do reads env f; reads env a
  | .lam _ t b _ | .forallE _ t b _ => do reads env t; reads env b
  | .letE _ t v b _ => do reads env t; reads env v; reads env b
  | .mdata _ b | .proj _ _ b => reads env b
  | _ => pure ()

run_meta do
  let env ← getEnv
  let sorted (xs : List Name) := xs.toArray.qsort (·.toString < ·.toString)
  let mut out := #["% GENERATED by `lake env lean scripts/ExportTypes.lean` from Usul.Typing (formal/lean). Do not edit.",
    "% The type system's declarations, read from the Lean kernel; the typing rules are in v41_typing.pl.",
    ":- encoding(utf8).",
    ":- discontiguous([qaida_type/2, type_extends/2, type_field/3, encoder_type/2, encoder_reads/3]).",
    ":- multifile([encoder_reads/3, type_field/3]).", ""]
  let types := sorted <| env.constants.toList.filterMap fun (n, _) =>
    if qaidaNs.isPrefixOf n && isStructure env n && n != qaidaNs then some n else none
  for t in types do
    let doc := (← findDocString? env t).getD ""
    out := out.push s!"qaida_type({atom t}, {quoted doc.trimAscii.toString})."
    for p in getStructureParentInfo env t do
      out := out.push s!"type_extends({atom t}, {atom p.structName})."
    for f in getStructureFields env t do
      if isParent env t f then continue
      let some pf := getProjFnForField? env t f | continue
      let ty ← forallTelescope (← inferType (mkConst pf)) fun _ b => pure b
      out := out.push s!"type_field({atom t}, {snake f.toString}, {quoted (toString (← ppExpr ty))})."
  out := out.push ""
  let encoders := sorted <| env.constants.toList.filterMap fun (n, ci) =>
    if (`Usul.Typing).isPrefixOf n && ci.type.getAppFn.constName? == some `Usul.Typing.Typed then some n else none
  for e in encoders do
    let some ci := env.find? e | continue
    let some v := ci.value? | continue
    let ((), fs) := (reads env v.getAppArgs[3]!).run #[]
    out := out.push s!"encoder_type({atom e}, {quoted (toString (← ppExpr ci.type.getAppArgs[1]!))})."
    for (f, i) in fs.toList.zipIdx do
      out := out.push s!"encoder_reads({atom e}, {i + 1}, {snake f.toString})."
  IO.FS.writeFile "../../examples/v41_types.pl" ("\n".intercalate out.toList ++ "\n")

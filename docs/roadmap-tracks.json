{
  "description": "The parallel tracks, each with its roadmap and the paths it owns. Each path belongs to one track, and a change to it updates that track's roadmap, or a commit says why not with a `Roadmap-Unchanged: <reason>` trailer. Shared infrastructure (registry, lock, fetch, Arabic normalisation, the CLI) belongs to no track. Checked by pipeline/usul_corpus/roadmap.py.",
  "hub": "docs/roadmap.md",
  "tracks": {
    "adq": {
      "title": "ADQ deontic-circuit harness",
      "roadmap": "docs/roadmap.md",
      "paths": ["examples/v3*.pl", "examples/v40_*.pl", "examples/*.json",
                "schemas/deontic_fact_bundle.schema.json", "schemas/finite_deontic_boundary.schema.json"]
    },
    "usul": {
      "title": "Ḥanbalī uṣūl formalization",
      "roadmap": "docs/roadmap-hanbali-usul-formalization.md",
      "prefix": "M",
      "paths": ["formal/lean/Usul.lean", "formal/lean/Usul/**", "formal/lean/UsulTest.lean", "formal/lean/UsulTest/**",
                "formal/lean-mathlib/**", "formal/tla/**",
                "corpus/citations/**", "corpus/dossier/**", "corpus/fatawa/**", "corpus/furuq/**", "corpus/mahall/**",
                "corpus/nusus/**", "corpus/proposals/**", "corpus/records/**", "corpus/review/**",
                "corpus/sheaf/**", "corpus/signature_map.json", "corpus/takhrij/**", "corpus/tanaqud/**", "corpus/types/**",
                "corpus/typing/**",
                "pipeline/usul_corpus/abwab.py", "pipeline/usul_corpus/deduction.py", "pipeline/usul_corpus/dossier.py",
                "pipeline/usul_corpus/encoders/**", "pipeline/usul_corpus/fatawa*.py", "pipeline/usul_corpus/furuq.py",
                "pipeline/usul_corpus/hudud.py", "pipeline/usul_corpus/judgement.py", "pipeline/usul_corpus/m5_commands.py",
                "pipeline/usul_corpus/m8_worklist.py", "pipeline/usul_corpus/mahall*.py", "pipeline/usul_corpus/nusus.py",
                "pipeline/usul_corpus/reconcil*.py", "pipeline/usul_corpus/scope.py", "pipeline/usul_corpus/sheaf.py",
                "pipeline/usul_corpus/signature_routing.py", "pipeline/usul_corpus/takhrij.py", "pipeline/usul_corpus/tanaqud.py"]
    },
    "hadith": {
      "title": "al-Albānī's ḥadīth methodology",
      "roadmap": "docs/roadmap-albani-hadith-methodology.md",
      "prefix": "H",
      "registry": "albani_hadith",
      "paths": ["formal/lean/Hadith.lean", "formal/lean/Hadith/**", "formal/lean/HadithTest.lean", "formal/lean/HadithTest/**",
                "formal/oracle/**", "corpus/hadith/**",
                "pipeline/usul_corpus/hadith.py", "pipeline/usul_corpus/grading.py", "pipeline/usul_corpus/oracle.py"]
    },
    "derivation": {
      "title": "Derivation method and the parallel lanes",
      "roadmap": "docs/roadmap-parallel-derivation.md",
      "paths": [".claude/skills/derivation-tranche/**", "docs/architecture/derivation-method.md",
                "corpus/worklists/**", "corpus/routing/**", "corpus/segmentation/**", "corpus/reconciliation/**",
                "examples/v41_*.pl",
                "pipeline/usul_corpus/shards.py", "pipeline/usul_corpus/r2_sample1.py", "pipeline/usul_corpus/routing.py",
                "pipeline/usul_corpus/units.py", "pipeline/usul_corpus/typed_routing.py",
                "pipeline/usul_corpus/semantic_*.py", "pipeline/usul_corpus/bank_review.py"]
    }
  }
}
